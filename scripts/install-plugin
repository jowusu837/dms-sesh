#!/usr/bin/env sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PLUGIN_NAME="DMSSesh"
MODE="symlink"
RELOAD=0
DEST_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/DankMaterialShell/plugins"
TARGET_DIR="$DEST_ROOT/$PLUGIN_NAME"
MANIFEST="$REPO_ROOT/plugin.json"

usage() {
    cat <<'EOF'
Usage: scripts/install-plugin [--copy|--symlink] [--reload]

Options:
  --copy       Copy plugin files into the DMS plugin directory
  --symlink    Symlink the repo into the DMS plugin directory (default)
  --reload     Reload the plugin through dms IPC after install
  -h, --help   Show this help message
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --copy)
            MODE="copy"
            ;;
        --symlink)
            MODE="symlink"
            ;;
        --reload)
            RELOAD=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'unknown argument: %s\n' "$1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

if [ ! -f "$MANIFEST" ]; then
    printf 'plugin manifest not found: %s\n' "$MANIFEST" >&2
    exit 1
fi

mkdir -p "$DEST_ROOT"
rm -rf "$TARGET_DIR"

if [ "$MODE" = "copy" ]; then
    mkdir -p "$TARGET_DIR"
    cp "$REPO_ROOT/plugin.json" "$TARGET_DIR/plugin.json"
    cp "$REPO_ROOT/DMSSesh.qml" "$TARGET_DIR/DMSSesh.qml"
    cp "$REPO_ROOT/DMSSeshSettings.qml" "$TARGET_DIR/DMSSeshSettings.qml"
    [ -f "$REPO_ROOT/README.md" ] && cp "$REPO_ROOT/README.md" "$TARGET_DIR/README.md"
    printf 'Copied %s to %s\n' "$PLUGIN_NAME" "$TARGET_DIR"
else
    ln -s "$REPO_ROOT" "$TARGET_DIR"
    printf 'Symlinked %s to %s\n' "$PLUGIN_NAME" "$TARGET_DIR"
fi

if [ "$RELOAD" -eq 1 ]; then
    if command -v dms >/dev/null 2>&1; then
        PLUGIN_ID=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["id"])' "$MANIFEST")
        STATUS=$(dms ipc plugins status "$PLUGIN_ID" 2>/dev/null || true)
        if [ "$STATUS" = "disabled" ]; then
            dms ipc plugins enable "$PLUGIN_ID"
        else
            dms ipc plugins reload "$PLUGIN_ID"
        fi
    else
        printf 'dms command not found; reload skipped\n' >&2
    fi
else
    printf 'Next: reload plugins in DMS, then trigger with se\n'
fi
